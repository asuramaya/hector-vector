# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Playwright dev venv for the E2E editor tests
.venv-e2e/

# --- Local workspace data (never publish) ---
inputs/
outputs/
.hector-config.json
.codex
# Smoke-test scratch outputs (tests/_out.svg, _nb.png, … — only cleaned on a fully green run)
tests/_*
# editor_e2e fail screenshots (#32): one PNG per failing check, regenerated each run
tests/e2e/_failshots/

# --- Vendored tool binaries (auto-installed on first run, not committed) ---
tools/cargo/
tools/realesrgan-ncnn-vulkan/
tools/realesrgan-ncnn-vulkan.zip
tools/_tmp_realesrgan/
tools/**/__pycache__/

# --- AI model weights (downloaded on first use) ---
*.onnx
*.pth
*.bin

# --- OS / editor / agent scaffolding ---
.DS_Store
*.swp
.idea/
.vscode/
.claude/

# Cloudflare Pages deploy bundle (generated by deploy-cloud.sh)
/dist/

# wrangler local state
/.wrangler/
